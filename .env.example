# ==============================================================================
# Miro App Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ==============================================================================

# Your Miro App Client ID (from https://miro.com/app/settings/user-profile/apps)
VITE_MIRO_CLIENT_ID=your_client_id_here

# Your Miro App Client Secret
VITE_MIRO_CLIENT_SECRET=your_client_secret_here

# The URL where this app is served (local dev or production)
VITE_APP_URL=http://localhost:3000
